# SākshyaChain Backend Server Environment Configuration Template
PORT=5000
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# CORS & IP Whitelist Architecture Configuration
# ALLOWED_ORIGINS: Comma-separated list of authorized frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.20.10.5:3000,http://10.20.20.12:3000

# ALLOWED_CLIENT_IPS: Comma-separated list of authorized client IP addresses/subnets
ALLOWED_CLIENT_IPS=127.0.0.1,::1,::ffff:127.0.0.1,10.20.10.,10.20.20.

# Enable Strict CORS & IP Firewall Enforcement
STRICT_CORS_ENABLED=true

# Supabase Database Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
